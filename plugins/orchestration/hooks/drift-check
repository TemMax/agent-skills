#!/usr/bin/env bash
# Provider-aware "orchestrator drift" Stop hook.
#
# Asks a separate model whether the orchestrator has drifted from its own wave
# plan, and surfaces the answer in the active host's Stop continuation shape.
#
# It never exits non-zero. Every unavailable path — missing files, a finished
# wave, a model call that fails, times out, returns empty, or answers
# off-contract — ends in "{}" and never claims a false clean verdict.
#
# Set DRIFT_CHECK_DRYRUN=1 to print the gating decision instead of calling the
# model. CLAUDE_DRIFT_CHECK_DRYRUN remains a compatibility fallback.

set -u

DRYRUN="${DRIFT_CHECK_DRYRUN:-${CLAUDE_DRIFT_CHECK_DRYRUN:-}}"
ACTIVE="${DRIFT_CHECK_ACTIVE:-${CLAUDE_DRIFT_CHECK_ACTIVE:-}}"

host_for_model() {
  case "$1" in
    gpt-*) printf codex ;;
    claude-*) printf claude ;;
    *) printf unknown ;;
  esac
}

codex_judge_for() {
  case "$1" in
    gpt-5.6-sol|gpt-5.6) printf gpt-5.6-terra ;;
    gpt-5.6-terra|gpt-5.6-luna) printf gpt-5.6-sol ;;
    *) return 1 ;;
  esac
}

# Silence, with the reason. The reason is only printed in dry-run: the harness
# wants JSON, a human debugging the gates wants the reason.
silent() {
  if [ -n "$DRYRUN" ]; then
    printf 'silent: %s\n' "$1"
  else
    printf '{}\n'
  fi
  exit 0
}

# --- gate 1: re-entrancy -----------------------------------------------------
# This hook shells out to a provider judge; that nested session can load the
# same plugin and fire this hook again. The inherited marker stops that loop.
if [ -n "$ACTIVE" ]; then
  silent "reentrant"
fi

# Always consume stdin so the caller never blocks on a full pipe.
payload="$(cat 2>/dev/null || true)"

# --- gate 1b: do not advise on a turn our own advice caused ------------------
# Advice injected at Stop makes the model continue, which fires Stop again. The
# payload's stop_hook_active marks exactly that continuation. Without this gate
# the hook advises, is re-triggered by the response, and advises again: measured
# 2026-08-11 at three deliveries and ~60s for one piece of advice, with nothing
# in the design bounding it.
if printf '%s' "$payload" | python3 -c '
import json, sys
try:
    sys.exit(0 if json.load(sys.stdin).get("stop_hook_active") else 1)
except Exception:
    sys.exit(1)
' 2>/dev/null; then
  silent "already-advised-this-chain"
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$repo_root" ]; then
  repo_root="$(pwd)"
fi

# --- gate 2+3: an ACTIVE plan must exist --------------------------------------
# Any plan under docs/superpowers/plans/, not only a wave plan: an orchestrator
# drifts from an implementation plan the same way it drifts from a wave — a task
# quietly dropped, a step reported done that nothing ran. The mechanism does not
# care which kind it is, only that the plan states its own tasks.
#
# Fail CLOSED: a plan is considered running only when it says `status: active`.
# A missing or unrecognised status keeps the hook off. The alternative — open by
# default, closed on `status: done` — reproduces the original defect for every
# plan whose author never wrote a status: the file outlives the work and the hook
# fires forever. A hook must not be able to switch itself on by omission.
plan_file=""
while IFS= read -r candidate; do
  [ -f "$candidate" ] || continue
  # Only the header counts: stop at the first code fence, and require the key at
  # column 0. A page that DOCUMENTS the feature by showing `status: active`
  # inside a ```yaml block must not switch the hook on — that is the
  # activate-by-omission failure this gate exists to prevent, wearing a hat.
  st="$(sed -n '1,40{/^```/q; s/^status:[[:space:]]*\([a-zA-Z-]*\).*/\1/p;}' "$candidate" | head -n1)"
  if [ "$st" = "active" ]; then
    plan_file="$candidate"
    break
  fi
done <<EOF
$(ls -t "$repo_root"/docs/superpowers/plans/*.md 2>/dev/null)
EOF

if [ -z "$plan_file" ]; then
  silent "no-active-plan"
fi

# --- gate 4: self-clearing safety net ----------------------------------------
# If the plan names branches and none of them still exist, the wave is over
# whatever the status field says. Branches disappear when work is merged, so
# this signal comes from the work itself rather than from anyone remembering to
# flip a field. Forgetting therefore degrades to silence, not to a permanent
# per-turn cost.
# Only branches the plan DECLARES, via a `branch:` key. Matching bare `wave/...`
# anywhere in the text silenced any generalised plan that merely mentioned an old
# branch in prose: the gate is wave-specific, the trigger no longer is.
planned_branches="$(sed -n 's/^[[:space:]-]*"\{0,1\}branch"\{0,1\}:[[:space:]]*"\{0,1\}\([A-Za-z0-9._\/-]*\)"\{0,1\}.*/\1/p' "$plan_file" 2>/dev/null | sort -u)"
if [ -n "$planned_branches" ]; then
  live=0
  for b in $planned_branches; do
    if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$b"; then
      live=1
      break
    fi
  done
  if [ "$live" -eq 0 ]; then
    silent "no-live-branches"
  fi
fi

# --- resolve the prompt -------------------------------------------------------
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  plugin_root="$CLAUDE_PLUGIN_ROOT"
else
  plugin_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd 2>/dev/null)"
fi

prompt_file="$plugin_root/skills/multi-model/references/orchestrator-drift-prompt.md"
if [ -z "$plugin_root" ] || [ ! -f "$prompt_file" ]; then
  silent "no-prompt"
fi

# --- gate 5: cost pre-filter (a heuristic, and labelled as one) ---------------
# Reading the transcript costs nothing; asking the model costs ~8s. Only ask when
# the ORCHESTRATOR claimed something — drift lives in what it says, not in what
# tools printed. Measured on 300 real sessions (2026-08-11): grepping broad
# keywords over the 200-line tail passes 99% of turns and saves nothing, because
# tool output and file contents are full of "done" and "passed". Matching
# claim-shaped phrasing against the last assistant message alone passes 13%.
# This filters COST, not correctness: a missed check in an advisory mechanism is
# a missed suggestion, which is why a heuristic is an acceptable trade here and
# would not be if the hook could block.
transcript_path="$(printf '%s' "$payload" | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin).get("transcript_path", "") or "")
except Exception:
    print("")
' 2>/dev/null || true)"

transcript_tail=""
if [ -n "$transcript_path" ] && [ -f "$transcript_path" ]; then
  transcript_tail="$(tail -n 200 "$transcript_path" 2>/dev/null || true)"
fi

# The last thing the assistant actually said this turn. It comes from the hook
# PAYLOAD, not from the transcript file: measured 2026-08-11, the Stop hook runs
# BEFORE the harness finishes writing the turn to the JSONL — in one live session
# the hook returned 67 seconds before the file was updated. Reading the file here
# means reading a turn that has not been written yet, and the gate below would
# silently never fire. The payload carries `last_assistant_message` directly.
last_said="$(printf '%s' "$payload" | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin).get("last_assistant_message", "") or "")
except Exception:
    print("")
' 2>/dev/null || true)"

session_id="$(printf '%s' "$payload" | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin).get("session_id", "") or "nosession")
except Exception:
    print("nosession")
' 2>/dev/null || echo nosession)"

model="$(printf '%s' "$payload" | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin).get("model", "") or "")
except Exception:
    print("")
' 2>/dev/null || true)"

# Keep the existing append-only audit record. Successful advice retains the
# original fields; unavailable checks add a status marker so absence cannot be
# mistaken for a clean verdict.
audit_entry() {
  local audit_status="$1" audit_advice="$2" digest_ok="$3"
  local log_dir="${TMPDIR:-/tmp}/claude-drift-log"
  mkdir -p "$log_dir" 2>/dev/null
  export DRIFT_DIGEST_OK="$digest_ok"
  export DRIFT_SESSION="$session_id" DRIFT_PLAN="$plan_file" DRIFT_SAID="$last_said"
  export DRIFT_AUDIT_STATUS="$audit_status"
  export DRIFT_LOG="$log_dir/${session_id}.jsonl"
  printf '%s' "$audit_advice" | python3 -c '
import json, sys, os
try:
    entry = {
        "session": os.environ.get("DRIFT_SESSION", ""),
        "plan": os.environ.get("DRIFT_PLAN", ""),
        "said": os.environ.get("DRIFT_SAID", "")[:400],
        "advice": sys.stdin.read()[:2000],
        "digest_ok": os.environ.get("DRIFT_DIGEST_OK", "") == "1",
    }
    status = os.environ.get("DRIFT_AUDIT_STATUS", "")
    if status:
        entry["status"] = status
    path = os.environ["DRIFT_LOG"]
    lines = []
    if os.path.exists(path):
        with open(path) as f:
            lines = f.readlines()[-199:]
    lines.append(json.dumps(entry) + "\n")
    with open(path, "w") as f:
        f.writelines(lines)
except Exception:
    pass
' 2>/dev/null || true
}

audit_unavailable() {
  audit_entry unavailable "drift-check unavailable" 0
}

if [ -z "$last_said" ]; then
  silent "nothing-said"
fi

if ! printf '%s' "$last_said" | grep -qiE '\b(i|we) (ran|verified|merged|pushed|completed|finished|tested)\b|\ball (tasks|three|of them)\b|\b(wave|task|plan)\b[^.]{0,40}\b(complete|done|finished)\b|\bnothing remaining\b|\bsummary:'; then
  silent "nothing-claimed"
fi

# Claude Stop omits model; its documented hook environment supplies the host.
# https://code.claude.com/docs/en/hooks#reference-scripts-by-path
# An explicit model still wins, and absence never supplies a Codex model id.
if [ -z "$model" ] && [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
  host=claude
else
  host="$(host_for_model "$model")"
fi
judge=""
case "$host" in
  claude)
    judge="claude-haiku-4-5-20251001"
    ;;
  codex)
    if ! judge="$(codex_judge_for "$model")"; then
      if [ -n "$DRYRUN" ]; then
        silent "unknown-model"
      fi
      audit_unavailable
      silent "unknown-model"
    fi
    ;;
  *)
    if [ -n "$DRYRUN" ]; then
      silent "unknown-model"
    fi
    audit_unavailable
    silent "unknown-model"
    ;;
esac

if [ -n "$DRYRUN" ]; then
  if [ "$host" = "codex" ]; then
    printf 'would-call: host=codex judge=%s effort=high\n' "$judge"
  else
    printf 'would-call\n'
  fi
  exit 0
fi

# --- the model call -----------------------------------------------------------
# The generic fake-answer seam is primary; the Claude-prefixed name remains a
# compatibility fallback. Presence is tracked separately so an empty fake can
# exercise the unavailable path without making a provider call.
fake_answer_set=0
fake_answer=""
if [ "${DRIFT_CHECK_FAKE_ANSWER+x}" = x ]; then
  fake_answer_set=1
  fake_answer="$DRIFT_CHECK_FAKE_ANSWER"
elif [ "${CLAUDE_DRIFT_CHECK_FAKE_ANSWER+x}" = x ]; then
  fake_answer_set=1
  fake_answer="$CLAUDE_DRIFT_CHECK_FAKE_ANSWER"
fi

if [ "$fake_answer_set" -eq 1 ]; then
  answer="$fake_answer"
  model_status=0
else
  prompt_text="$(cat "$prompt_file" 2>/dev/null || true)"
  plan_text="$(cat "$plan_file" 2>/dev/null || true)"
  full_prompt="$(printf '%s\n\n---\nPlan (%s):\n%s\n\n---\nRecent transcript tail:\n%s\n\n---\nWhat the orchestrator said as it finished this turn:\n%s\n' \
    "$prompt_text" "$plan_file" "$plan_text" "$transcript_tail" "$last_said")"

  # A neutral directory keeps repository-local context from competing with the
  # complete prompt supplied here.
  neutral_dir="$(mktemp -d 2>/dev/null || echo "${TMPDIR:-/tmp}")"
  if [ "$host" = "codex" ]; then
    answer_file="$(mktemp 2>/dev/null || echo "/tmp/drift-check-answer.$$")"
    schema="$plugin_root/hooks/drift-verdict.schema.json"
    ( cd "$neutral_dir" && printf '%s' "$full_prompt" \
      | DRIFT_CHECK_ACTIVE=1 timeout 300 codex exec \
          --ephemeral --ignore-user-config --ignore-rules \
          --skip-git-repo-check \
          --sandbox read-only \
          --model "$judge" \
          -c 'model_reasoning_effort="high"' \
          --output-schema "$schema" \
          --output-last-message "$answer_file" \
          - >/dev/null 2>/dev/null )
    model_status=$?
    answer="$(cat "$answer_file" 2>/dev/null || true)"
    rm -f "$answer_file" 2>/dev/null
  else
    tmp_out="$(mktemp 2>/dev/null || echo "/tmp/drift-check.$$")"
    ( cd "$neutral_dir" && DRIFT_CHECK_ACTIVE=1 CLAUDE_DRIFT_CHECK_ACTIVE=1 \
      claude -p "$full_prompt" \
        --model "$judge" \
        --permission-mode plan \
        --permission-prompts none \
        --no-session-persistence \
        </dev/null >"$tmp_out" 2>/dev/null ) &
    claude_pid=$!

    # The watchdog must not inherit our stdout: a caller using $(...) waits for
    # every process holding that pipe, and killing this subshell does not reap
    # its own `sleep` child.
    (
      sleep 45
      kill -TERM "$claude_pid" 2>/dev/null
    ) >/dev/null 2>&1 &
    watchdog_pid=$!

    wait "$claude_pid" 2>/dev/null
    model_status=$?
    kill "$watchdog_pid" 2>/dev/null
    wait "$watchdog_pid" 2>/dev/null

    answer="$(cat "$tmp_out" 2>/dev/null || true)"
    rm -f "$tmp_out" 2>/dev/null
  fi
  [ -n "${neutral_dir:-}" ] && rmdir "$neutral_dir" 2>/dev/null
fi

if [ "$model_status" -ne 0 ] || [ -z "$answer" ]; then
  audit_unavailable
  silent "model-failed"
fi

if [ "$host" = "codex" ]; then
  parsed="$(printf '%s' "$answer" | python3 -c '
import json, sys
try:
    value = json.load(sys.stdin)
    if not isinstance(value, dict) or set(value) != {"status", "advice"}:
        raise ValueError
    status = value["status"]
    advice = value["advice"]
    if status not in ("nothing", "advice") or not isinstance(advice, list):
        raise ValueError
    if any(not isinstance(item, str) or len(item) == 0 for item in advice):
        raise ValueError
    if status == "nothing" and not advice:
        print("NOTHING", end="")
    elif status == "advice" and advice:
        print("\n".join(advice), end="")
    else:
        raise ValueError
except Exception:
    sys.exit(1)
' 2>/dev/null)"
  parsed_status=$?
  if [ "$parsed_status" -ne 0 ]; then
    audit_unavailable
    silent "off-contract-answer"
  fi
  answer="$parsed"
else
  # Claude's established contract remains bullet points or the word NOTHING.
  trimmed="$(printf '%s' "$answer" | tr -d '[:space:]')"
  if [ "$trimmed" != "NOTHING" ] && ! printf '%s' "$answer" \
       | sed -e 's/^[[:space:]]*//' | head -n1 \
       | grep -qE '^([-*•]|[0-9]+[.)])[[:space:]]'; then
    audit_unavailable
    silent "off-contract-answer"
  fi
fi

trimmed="$(printf '%s' "$answer" | tr -d '[:space:]')"
if [ "$trimmed" = "NOTHING" ]; then
  silent "nothing-to-say"
fi

# --- do not say the same thing twice ------------------------------------------
# The check has no memory across invocations, so during a live wave it would
# hand the orchestrator the identical note on every claim-shaped turn. Repeated
# identical advice is the fastest way to train someone to ignore an advisory,
# and the prompt cannot prevent it: each call is stateless. The memo is keyed by
# session and holds a digest of the last advice actually delivered.
memo="${TMPDIR:-/tmp}/claude-drift-memo-${session_id}"
# shasum is a perl script and is absent on many Linux images, where sha256sum is
# the one present. Without a fallback the memo silently never writes and the
# repeat suppression is dead while looking alive.
digest=""
for hasher in "shasum -a 256" "sha256sum" "openssl dgst -sha256"; do
  command -v "${hasher%% *}" >/dev/null 2>&1 || continue
  digest="$(printf '%s' "$answer" | $hasher 2>/dev/null | tr -d '\n' | grep -oE '[0-9a-f]{64}' | head -n1)"
  [ -n "$digest" ] && break
done
if [ -n "$digest" ] && [ -f "$memo" ] && [ "$(cat "$memo" 2>/dev/null)" = "$digest" ]; then
  silent "already-said-this"
fi

escaped="$(printf '%s' "$answer" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))' 2>/dev/null || true)"
if [ -z "$escaped" ]; then
  silent "escape-failed"
fi

[ -n "$digest" ] && printf '%s' "$digest" > "$memo" 2>/dev/null

# --- keep a record of what was advised ----------------------------------------
# The append-only record keeps its established location and successful-advice
# shape for both hosts.
if [ -n "$digest" ]; then
  digest_ok=1
else
  digest_ok=0
fi
audit_entry "" "$answer" "$digest_ok"

if [ "$host" = "codex" ]; then
  printf '{"decision":"block","reason":%s}\n' "$escaped"
else
  printf '{"hookSpecificOutput":{"hookEventName":"Stop","additionalContext":%s}}\n' "$escaped"
fi
exit 0
