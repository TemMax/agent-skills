#!/usr/bin/env bash
# Offline double for `codex exec`, used only by codex-wave-runner.test.mjs.
# Never calls a real model or touches the network.
#
# Env vars:
#   CODEX_STUB_LOG            required — base path for the log. Each record
#                              (one per start and one per end of a call) is
#                              written to its own file under
#                              "${CODEX_STUB_LOG}.d/", named
#                              "<start-ns>-<pid>-<start|end>.json", via a
#                              temp-file-then-rename so concurrent stub
#                              processes never interleave writes into a shared
#                              file. readLog(path) in the test reads every
#                              *.json file in "${path}.d" and returns the
#                              records sorted by timestamp. The start record
#                              carries the exact prompt received on stdin, so
#                              a caller can assert a prompt file equals what
#                              was actually sent. The start record also
#                              carries "symlinks": the names of top-level
#                              symlinks in its cwd (never their content), so a
#                              caller can assert a worktree link landed before
#                              the child ran.
#   CODEX_STUB_SLEEP          seconds to sleep between start and end (default 0).
#   CODEX_STUB_EXECUTOR_MODE  good|empty|fail — only consulted for a fresh
#                              executor invocation (prompt starts with
#                              "# Task:", argv is not `exec resume`).
#                              good: create/commit a file, write a report.
#                              When that file is already committed unchanged
#                              (a fresh retry in a worktree an earlier call
#                              committed to), it commits a per-call file
#                              instead, like CODEX_STUB_RESUME_MODE=good.
#                              empty: write an empty report.
#                              fail: exit 1 without writing a report; also
#                              prints CODEX_STUB_FAIL_STDERR to stderr first,
#                              if set.
#   CODEX_STUB_FAIL_STDERR    text printed to stderr before a CODEX_STUB_EXECUTOR_MODE=fail
#                              exit (default: nothing printed).
#   CODEX_STUB_RESUME_MODE    good|fail (default good) — only consulted for an
#                              `exec resume <id> …` invocation, which is always
#                              an executor call whatever its prompt's first
#                              line is. `exec resume` has no -C, so the
#                              worktree is the process cwd.
#                              good: commit a new file whose name differs per
#                              call (src/<task>/rework-<ns>.txt), write a
#                              non-empty report.
#                              fail: exit 1 without writing a report.
#   CODEX_STUB_VERDICTS       optional JSON array of verdict objects, consumed
#                              in order by successive supervisor invocations
#                              (the counter lives in
#                              "${CODEX_STUB_LOG}.d/verdicts.count"). When it
#                              is exhausted or unset, CODEX_STUB_VERDICT / the
#                              default clean verdict applies.
#   CODEX_STUB_VERDICT        JSON text written verbatim to the -o file for a
#                              supervisor invocation (prompt starts with
#                              "# Supervisor Prompt"). Defaults to a clean
#                              verdict with no violations and one remark:
#                              {"ok":true,"violations":[],"remarks":["stub: clean"]}.
#   CODEX_STUB_SANDBOX_OUTPUT text printed (to stdout) for a `sandbox` argv[0]
#                              invocation (the preflight probe). Nothing else
#                              runs: the wrapped `bash -c` command is never
#                              actually executed by this double.
#   CODEX_STUB_SANDBOX_EXIT   exit code for a `sandbox` invocation (default 0).
#   CODEX_STUB_SANDBOX_BLOCK_CMDS
#                              optional, one wrapped command per line. When
#                              set, CODEX_STUB_SANDBOX_OUTPUT is printed and
#                              CODEX_STUB_SANDBOX_EXIT is used only for a
#                              `sandbox` invocation whose wrapped command (the
#                              last argv) equals one of these lines; any other
#                              command prints nothing and exits 0. Unset (or
#                              empty): every `sandbox` invocation behaves the
#                              same, as described above.
#
# Every `exec` invocation prints {"type":"thread.started","thread_id":"<id>"}
# as its first stdout line: the resume id for `exec resume <id>`, otherwise a
# new "stub-thread-<pid>-<ns>". Usage is thread-cumulative, like the real CLI:
# a per-thread call counter lives in "${CODEX_STUB_LOG}.d/thread-<id>.calls",
# and the closing turn.completed carries the thread's running total (each call
# adds input_tokens 100, cached_input_tokens 10, output_tokens 50,
# reasoning_output_tokens 5).
set -euo pipefail

if [ -z "${CODEX_STUB_LOG:-}" ]; then
  echo "codex-stub: CODEX_STUB_LOG must be set" >&2
  exit 64
fi

log_dir="${CODEX_STUB_LOG}.d"
mkdir -p "$log_dir"

now_ms() { node -e 'process.stdout.write(String(Date.now()))'; }
now_ns() { node -e 'process.stdout.write(String(process.hrtime.bigint()))'; }

# Writes one JSON record as its own file under log_dir, via a temp file in
# the same directory followed by `mv` (a rename within one directory is
# atomic), so concurrent stub processes appending records never interleave
# or corrupt each other's writes the way a shared `>>` log would.
write_record() {
  # $1 = phase (start|end), $2 = JSON content
  phase="$1"
  content="$2"
  tmp="$(mktemp "$log_dir/tmp.XXXXXX")"
  printf '%s' "$content" > "$tmp"
  mv "$tmp" "$log_dir/$(now_ns)-$$-${phase}.json"
}

json_string() {
  # Minimal JSON string escaping for the small values this stub ever logs.
  node -e 'process.stdout.write(JSON.stringify(process.argv[1]))' -- "$1"
}

argv_json="["
first=1
for a in "$@"; do
  [ "$first" -eq 1 ] || argv_json+=","
  first=0
  argv_json+="$(json_string "$a")"
done
argv_json+="]"

# The preflight probe: `<codex> sandbox -c ... -- bash -c '<cmd>'`. Never a
# model call (no prompt, no -o file), so it is handled entirely separately
# from the executor/supervisor dispatch below, before anything reads stdin.
# Per this double's contract: log argv, run nothing (the wrapped `bash -c`
# command is never actually executed), print CODEX_STUB_SANDBOX_OUTPUT, exit
# CODEX_STUB_SANDBOX_EXIT — for every command, or only for the commands
# listed in CODEX_STUB_SANDBOX_BLOCK_CMDS when that is set.
if [ "${1:-}" = "sandbox" ]; then
  cwd="$(pwd)"
  start_ts="$(now_ms)"
  start_record="$(printf '{"event":"start","ts":%s,"cwd":%s,"argv":%s,"prompt":null,"symlinks":[]}' \
    "$start_ts" "$(json_string "$cwd")" "$argv_json")"
  write_record start "$start_record"

  sleep "${CODEX_STUB_SLEEP:-0}"

  wrapped_cmd="${!#}"
  chosen=1
  if [ -n "${CODEX_STUB_SANDBOX_BLOCK_CMDS:-}" ]; then
    chosen=0
    while IFS= read -r block_cmd; do
      if [ "$block_cmd" = "$wrapped_cmd" ]; then chosen=1; fi
    done <<< "$CODEX_STUB_SANDBOX_BLOCK_CMDS"
  fi

  exit_code=0
  if [ "$chosen" -eq 1 ]; then
    printf '%s' "${CODEX_STUB_SANDBOX_OUTPUT:-}"
    exit_code="${CODEX_STUB_SANDBOX_EXIT:-0}"
  fi

  end_ts="$(now_ms)"
  end_record="$(printf '{"event":"end","ts":%s,"cwd":%s,"argv":%s,"exit":%s}' \
    "$end_ts" "$(json_string "$cwd")" "$argv_json" "$exit_code")"
  write_record end "$end_record"

  exit "$exit_code"
fi

resume=0
thread_id=""
if [ "${1:-}" = "exec" ]; then
  if [ "${2:-}" = "resume" ]; then
    resume=1
    thread_id="${3:-}"
  else
    thread_id="stub-thread-$$-$(now_ns)"
  fi
  printf '{"type":"thread.started","thread_id":%s}\n' "$(json_string "$thread_id")"
fi

worktree=""
outfile=""
schema=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -C) worktree="$2"; shift 2 ;;
    -o) outfile="$2"; shift 2 ;;
    --output-schema) schema="$2"; shift 2 ;;
    *) shift ;;
  esac
done
# `exec resume` accepts no -C: the caller sets the process cwd instead.
if [ -z "$worktree" ]; then
  worktree="$(pwd)"
fi

# Captured to a file, never a shell variable: `$(cat -)` command substitution
# strips trailing newlines, which would silently corrupt the byte-for-byte
# comparison the test makes between a written prompt file and what this stub
# logged it received. Node reads the file back for both the case match below
# and the JSON log line, so the exact bytes survive both.
promptfile="$(mktemp)"
trap 'rm -f "$promptfile"' EXIT
cat - > "$promptfile"
prompt="$(cat "$promptfile")" # fine for a prefix check; never used for logging

start_ts="$(now_ms)"
prompt_json="$(node -e 'process.stdout.write(JSON.stringify(require("fs").readFileSync(process.argv[1], "utf8")))' -- "$promptfile")"
# Top-level symlink names in cwd, never their content (see the secrets
# sentence in the Plan Format section of super-plan/SKILL.md).
symlinks_json="["
first_symlink=1
if [ -n "$worktree" ] && [ -d "$worktree" ]; then
  while IFS= read -r link; do
    [ -n "$link" ] || continue
    [ "$first_symlink" -eq 1 ] || symlinks_json+=","
    first_symlink=0
    symlinks_json+="$(json_string "$(basename "$link")")"
  done < <(find "$worktree" -maxdepth 1 -type l 2>/dev/null)
fi
symlinks_json+="]"
start_record="$(printf '{"event":"start","ts":%s,"cwd":%s,"argv":%s,"prompt":%s,"symlinks":%s}' \
  "$start_ts" "$(json_string "$worktree")" "$argv_json" "$prompt_json" "$symlinks_json")"
write_record start "$start_record"

sleep "${CODEX_STUB_SLEEP:-0}"

# Commits one new file whose name differs per call and writes a non-empty
# report. Used wherever re-committing the first attempt's path would fail on
# an unchanged file.
commit_rework() {
  slug="$(basename "$worktree")"
  task_id="${slug#wave-}"
  rel="src/${task_id}/rework-$(now_ns).txt"
  mkdir -p "$worktree/src/${task_id}"
  printf 'stub executor rework\n' > "$worktree/$rel"
  git -C "$worktree" -c commit.gpgsign=false -c user.name="Codex Stub" \
    -c user.email="codex-stub@example.invalid" add "$rel"
  git -C "$worktree" -c commit.gpgsign=false -c user.name="Codex Stub" \
    -c user.email="codex-stub@example.invalid" commit -m "stub: task rework" --quiet
  printf 'reworked via stub\n\nmust_run output:\nOK\n' > "$outfile"
}

kind="$prompt"
if [ "$resume" -eq 1 ]; then
  kind='# Resume'
fi

exit_code=0
case "$kind" in
  '# Resume')
    mode="${CODEX_STUB_RESUME_MODE:-good}"
    case "$mode" in
      good)
        commit_rework
        ;;
      fail)
        exit_code=1
        ;;
      *)
        echo "codex-stub: unknown CODEX_STUB_RESUME_MODE '$mode'" >&2
        exit_code=1
        ;;
    esac
    ;;
  '# Task:'*)
    mode="${CODEX_STUB_EXECUTOR_MODE:-good}"
    case "$mode" in
      good)
        # The worktree is always .worktrees/wave-<task-id> (codex-wave-state.mjs
        # makeState); derive the task id from it so parallel tasks never write
        # the same relative path and collide in files_allowed.
        slug="$(basename "$worktree")"
        task_id="${slug#wave-}"
        rel="src/${task_id}/stub-output.txt"
        mkdir -p "$worktree/src/${task_id}"
        printf 'stub executor work\n' > "$worktree/$rel"
        git -C "$worktree" -c commit.gpgsign=false -c user.name="Codex Stub" \
          -c user.email="codex-stub@example.invalid" add "$rel"
        if git -C "$worktree" diff --cached --quiet; then
          commit_rework
        else
          git -C "$worktree" -c commit.gpgsign=false -c user.name="Codex Stub" \
            -c user.email="codex-stub@example.invalid" commit -m "stub: task work" --quiet
          printf 'implemented via stub\n\nmust_run output:\nOK\n' > "$outfile"
        fi
        ;;
      empty)
        printf '' > "$outfile"
        ;;
      fail)
        if [ -n "${CODEX_STUB_FAIL_STDERR:-}" ]; then
          printf '%s\n' "$CODEX_STUB_FAIL_STDERR" >&2
        fi
        exit_code=1
        ;;
      *)
        echo "codex-stub: unknown CODEX_STUB_EXECUTOR_MODE '$mode'" >&2
        exit_code=1
        ;;
    esac
    ;;
  '# Supervisor Prompt'*)
    verdict=""
    if [ -n "${CODEX_STUB_VERDICTS:-}" ]; then
      verdict_counter="$log_dir/verdicts.count"
      verdict_index="$(cat "$verdict_counter" 2>/dev/null || printf '0')"
      verdict="$(node -e '
        const list = JSON.parse(process.env.CODEX_STUB_VERDICTS)
        const index = Number(process.argv[1])
        if (index < list.length) process.stdout.write(JSON.stringify(list[index]))
      ' -- "$verdict_index")"
      printf '%s' "$((verdict_index + 1))" > "$verdict_counter"
    fi
    if [ -z "$verdict" ]; then
      verdict="${CODEX_STUB_VERDICT:-}"
    fi
    if [ -z "$verdict" ]; then
      verdict='{"ok":true,"violations":[],"remarks":["stub: clean"]}'
    fi
    if [ -n "$schema" ]; then :; fi # schema path is only recorded, never validated here
    printf '%s' "$verdict" > "$outfile"
    ;;
  *)
    echo "codex-stub: prompt matched neither an executor nor a supervisor prompt" >&2
    exit_code=1
    ;;
esac

thread_counter="$log_dir/thread-${thread_id}.calls"
thread_calls="$(cat "$thread_counter" 2>/dev/null || printf '0')"
thread_calls="$((thread_calls + 1))"
printf '%s' "$thread_calls" > "$thread_counter"
printf '{"type":"turn.completed","usage":{"input_tokens":%s,"cached_input_tokens":%s,"output_tokens":%s,"reasoning_output_tokens":%s}}\n' \
  "$((thread_calls * 100))" "$((thread_calls * 10))" "$((thread_calls * 50))" "$((thread_calls * 5))"

end_ts="$(now_ms)"
end_record="$(printf '{"event":"end","ts":%s,"cwd":%s,"argv":%s,"exit":%s}' \
  "$end_ts" "$(json_string "$worktree")" "$argv_json" "$exit_code")"
write_record end "$end_record"

exit "$exit_code"
